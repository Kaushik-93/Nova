# Nova configuration. `make env` copies this to .env and replaces every
# __GENERATE__ value with a random secret. Never commit .env.

# --- LLM ---------------------------------------------------------------------
# MODEL_PROVIDER is `anthropic` or `openai`; set the matching key. Claude is the
# default. For testing with OpenAI use: MODEL_PROVIDER=openai, MODEL_NAME=gpt-6-luna.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Superset ----------------------------------------------------------------
# SUPERSET_URL is how containers reach Superset; SUPERSET_PUBLIC_URL is how a
# browser reaches it, and the two differ because of the host port mapping.
SUPERSET_URL=http://superset:8088
SUPERSET_PUBLIC_URL=http://localhost:18088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=__GENERATE__
SUPERSET_SECRET_KEY=__GENERATE__
SUPERSET_GUEST_TOKEN_SECRET=__GENERATE__

# --- Application -------------------------------------------------------------
# Encrypts stored source credentials.
FERNET_KEY=__GENERATE_FERNET__
# The browser origin of the Nova UI; the only origin allowed to frame dashboards.
NOVA_UI_ORIGIN=http://localhost:13000

# --- Sign-in -----------------------------------------------------------------
# NOVA_ADMIN_EMAIL signs in with NOVA_ADMIN_PASSWORD, and is created on first start.
NOVA_ADMIN_EMAIL=admin@nova.local
NOVA_ADMIN_PASSWORD=__GENERATE__
NOVA_JWT_SECRET=__GENERATE__
NOVA_PUBLIC_API_URL=http://localhost:18000

# --- SSO (optional): OpenID Connect ------------------------------------------
# Works with Okta, Microsoft Entra ID, Google, Auth0, Keycloak and others. Leave the
# discovery URL empty to keep SSO off. Register this redirect URI with your provider:
#   ${NOVA_PUBLIC_API_URL}/api/auth/sso/callback
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The button says "Continue with" this name.
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES="openid email profile"
# Comma-separated. Empty allows every domain your provider will sign in.
OIDC_ALLOWED_DOMAINS=
# Comma-separated emails that become administrators on first sign-in.
OIDC_ADMIN_EMAILS=

# --- Metadata Postgres (Superset metadata + Nova application database) -------
METADATA_DB_USER=nova
METADATA_DB_PASSWORD=__GENERATE__
DATABASE_URL=postgresql://${METADATA_DB_USER}:${METADATA_DB_PASSWORD}@metadata-db:5432/nova

# --- Redis / Trino -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
TRINO_URL=http://trino:8080

# --- Demo data sources -------------------------------------------------------
# Owner credentials are used only by the seed job. The agent, Trino and Superset
# connect as the read-only user `nova_ro`.
DEMO_OWNER_PASSWORD=__GENERATE__
DEMO_RO_PASSWORD=__GENERATE__

# --- Observability (optional) ------------------------------------------------
LANGSMITH_API_KEY=

# --- Agent run budgets -------------------------------------------------------
NOVA_MAX_STEPS=150
NOVA_MAX_TOKENS=2000000
NOVA_MAX_WALL_SECONDS=900
NOVA_MAX_SQL_QUERIES=120

# --- Host ports --------------------------------------------------------------
# All published on 127.0.0.1 only, in the 1xxxx range so Nova can run alongside
# anything already using the usual ports.
SUPERSET_HOST_PORT=18088
TRINO_HOST_PORT=18080
METADATA_DB_HOST_PORT=15432
DEMO_POSTGRES_HOST_PORT=15433
DEMO_MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
API_HOST_PORT=18000
UI_HOST_PORT=13000
